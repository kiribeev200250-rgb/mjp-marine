DATABASE_URL=postgresql://user:password@host:5432/mjpmarine
DIRECT_URL=postgresql://user:password@host:5432/mjpmarine
NEXTAUTH_SECRET=your-secret-here-min-32-chars
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://mjpmarine.es
RESEND_API_KEY=re_xxxxxxxxxxxx
ADMIN_EMAIL=admin@mjpmarine.es
OWNER_EMAIL=owner@mjpmarine.es

# CRM — отдельный secret чтобы не конфликтовать с CMS-admin сессией
CRM_NEXTAUTH_SECRET=your-crm-secret-here-min-32-chars-different-from-above

# Google Service Account (добавляется на Этапе 5 — Финансы)
# GOOGLE_SA_CLIENT_EMAIL=...
# GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# GOOGLE_SHEETS_ID=1_nFTlprxT8imeA81awGMwpVd74l0f381eViLxDJNBjE
# GOOGLE_DRIVE_RECEIPTS_FOLDER=...

# Telegram Bot (Этап 7)
# TELEGRAM_BOT_TOKEN=...            — от @BotFather
# TELEGRAM_WEBHOOK_SECRET=...       — случайная строка, проверяется в заголовке апдейтов от Telegram
# CRON_SECRET=...                   — Vercel Cron Jobs шлёт его в Authorization: Bearer <CRON_SECRET>

# Supabase Storage — фото до/после для задач планировщика
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...     — Project Settings → API → service_role secret (или новый sb_secret_...), НЕ anon-ключ
