generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SiteConfig {
  id                 Int      @id @default(1)
  companyName        String   @default("MJP Marine Service")
  phone              String   @default("")
  whatsapp           String   @default("")
  email              String   @default("")
  hours              String   @default("")
  coverage           String   @default("")
  instagram          String   @default("")
  facebook           String   @default("")
  whatsappUrl        String   @default("")
  tiktok             String   @default("")
  youtube            String   @default("")
  logoUrl            String?
  heroBgUrl          String?
  heroOverlayOpacity Float    @default(0.75)
  faviconUrl         String?
  colorPrimary       String   @default("#0A2342")
  colorAccent        String   @default("#C9A84C")
  colorText          String   @default("#FFFFFF")
  showHeroStats      Boolean  @default(true)
  heroAnimation      String   @default("none")
  servicesBgColor    String?
  servicesCardStyle  String   @default("bordered")
  showPriceLabel     Boolean  @default(true)
  footerBgColor      String?
  footerShowBrand    Boolean  @default(true)
  footerShowNav      Boolean  @default(true)
  footerShowSocial   Boolean  @default(true)
  footerCustomLinks  String   @default("[]")
  showGallery        Boolean  @default(false)
  showAnimations     Boolean  @default(true)
  showWave           Boolean  @default(true)
  metaTitle          String   @default("MJP Marine Service — Mobile Yacht Repair Costa Blanca")
  metaDesc           String   @default("Mobile yacht repair & maintenance in Costa Blanca. We come to your marina. 48h response. Alicante · Dénia · Torrevieja.")
  updatedAt          DateTime @updatedAt
}

model GalleryItem {
  id          Int      @id @default(autoincrement())
  title       String
  titleEs     String   @default("")
  titleRu     String   @default("")
  titleUk     String   @default("")
  description String   @default("")
  descEs      String   @default("")
  descRu      String   @default("")
  descUk      String   @default("")
  beforeUrl   String
  afterUrl    String
  serviceTag  String   @default("")
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Service {
  id         Int    @id @default(autoincrement())
  icon       String @default("⚓")
  nameEn     String
  nameEs     String
  nameRu     String
  nameUk     String
  descEn     String
  descEs     String
  descRu     String
  descUk     String
  priceLabel String
  sortOrder  Int    @default(0)
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  boatType  String
  marina    String
  rating    Int
  textEn    String
  textEs    String
  textRu    String
  textUk    String
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PageText {
  id  Int    @id @default(autoincrement())
  key String @unique
  en  String
  es  String
  ru  String
  uk  String
}

model ContactRequest {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  marina    String?
  boatType  String?
  service   String?
  message   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  language  String   @default("en")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model PresiteLink {
  id        Int           @id @default(autoincrement())
  platform  String
  label     String
  url       String
  active    Boolean       @default(true)
  sortOrder Int           @default(0)
  stats     PresiteStat[]
}

model PresiteConfig {
  id         Int     @id @default(1)
  taglineEn  String  @default("Mobile Yacht Repair · Costa Blanca")
  taglineEs  String  @default("Reparación Náutica Móvil · Costa Blanca")
  taglineRu  String  @default("Мобильный яхтенный сервис · Коста Бланка")
  taglineUk  String  @default("Мобільний яхтовий сервіс · Коста Бланка")
  pageTitle  String  @default("MJP Marine Service")
  showWave   Boolean @default(true)
  bgStyle    String  @default("gradient")
  footerText String  @default("© 2026 MJP Marine Service · Costa Blanca, España")
}

model PresiteStat {
  id        Int         @id @default(autoincrement())
  linkId    Int
  link      PresiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  source    String      @default("direct")
  clickedAt DateTime    @default(now())
}

model PresiteScan {
  id        Int      @id @default(autoincrement())
  source    String   @default("qr")
  scannedAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════
// CRM — внутренняя система управления MJP Marine Service
// Все таблицы изолированы от публичного сайта через companyId
// ═══════════════════════════════════════════════════════════════

// ─── КОМПАНИЯ И ПОЛЬЗОВАТЕЛИ ────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users       CrmUser[]
  clients     Client[]
  tasks       Task[]
  inventory   InventoryItem[]
  finances    FinanceEntry[]
  capitals    CapitalEntry[]
  vatEntries  VatEntry[]
  invoices    Invoice[]
  quotes      Quote[]
  references  ReferenceItem[]
  categories  Category[]
  notes       Note[]
  auditLogs   AuditLog[]
  companyInfo CompanyInfo?
  goals       KpiGoal[]
  reminders   Reminder[]
}

model CrmUser {
  id                    String    @id @default(cuid())
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id])
  email                 String    @unique
  password              String
  name                  String
  role                  CrmRole   @default(EMPLOYEE)
  // Матрица прав: { "CLIENTS": ["VIEW","CREATE"], "FINANCE": ["VIEW"] }
  permissions           Json      @default("{}")
  telegramId            String?   @unique
  // Код для привязки Telegram (/link <код>) — одноразовый, с истечением
  telegramLinkCode      String?   @unique
  telegramLinkExpiresAt DateTime?
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  assignedTasks Task[]     @relation("TaskAssignee")
  auditLogs     AuditLog[]
  notes         Note[]
}

// Хранилище сессий grammY (диалоги бота переживают серверлесс-инвокейшены)
model TelegramSession {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

enum CrmRole {
  ADMIN
  EMPLOYEE
}

// Реквизиты компании для счетов — заполняется в настройках CRM
model CompanyInfo {
  id             String  @id @default(cuid())
  companyId      String  @unique
  company        Company @relation(fields: [companyId], references: [id])
  legalName      String  @default("ЗАПОЛНИТЬ ПЕРЕД ИСПОЛЬЗОВАНИЕМ")
  nif            String  @default("ЗАПОЛНИТЬ ПЕРЕД ИСПОЛЬЗОВАНИЕМ")
  address        String  @default("ЗАПОЛНИТЬ ПЕРЕД ИСПОЛЬЗОВАНИЕМ")
  city           String  @default("ЗАПОЛНИТЬ ПЕРЕД ИСПОЛЬЗОВАНИЕМ")
  postalCode     String  @default("ЗАПОЛНИТЬ ПЕРЕД ИСПОЛЬЗОВАНИЕМ")
  country        String  @default("España")
  email          String  @default("")
  phone          String  @default("")
  bankAccount    String  @default("")
  logoUrl        String?
  ivaRate        Decimal @default(21) @db.Decimal(5, 2)
  irpfRate       Decimal @default(0) @db.Decimal(5, 2)
  invoicePrefix  String  @default("F")
  quotePrefix    String  @default("P")
  nextInvoiceNum Int     @default(1)
  nextQuoteNum   Int     @default(1)
  currentYear    Int     @default(2025)
  // Facebook Lead Ads — по умолчанию выключено
  fbEnabled      Boolean @default(false)
  fbAppId        String?
  fbPageToken    String?
  fbVerifyToken  String?
}

// ─── АУДИТ ──────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String?
  user      CrmUser? @relation(fields: [userId], references: [id])
  action    String // CREATE | UPDATE | DELETE | STATUS_CHANGE | STOCK_MOVE
  entity    String // FinanceEntry | StockMovement | Invoice | Task | ...
  entityId  String
  oldValue  Json?
  newValue  Json?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([companyId, entity, entityId])
  @@index([companyId, createdAt])
}

// ─── КЛИЕНТЫ И ВОРОНКА ──────────────────────────────────────────

model Client {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  firstName   String
  lastName    String
  phone       String       @default("")
  email       String       @default("")
  source      ClientSource @default(MANUAL)
  language    String       @default("ru")
  marina      String       @default("")
  notes       String       @default("")
  funnelStage FunnelStage  @default(NEW_LEAD)
  active      Boolean      @default(true)
  fbLeadId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  yachts       Yacht[]
  quotes       Quote[]
  tasks        Task[]
  invoices     Invoice[]
  finances     FinanceEntry[]
  stageHistory FunnelHistory[]
  noteEntries  Note[]

  @@index([companyId, funnelStage])
  @@index([companyId, source])
}

enum ClientSource {
  FACEBOOK
  MANUAL
  REFERRAL
  WEBSITE
  WHATSAPP
  OTHER
}

enum FunnelStage {
  NEW_LEAD // Новый лид
  CONTACT_MADE // Контакт установлен
  QUOTE_SENT // Предварительная оценка (пресмет)
  WORK_SCHEDULED // Работа запланирована
  WORK_DONE // Выполнено
  INVOICE_SENT // Счёт выставлен
  PAID // Оплачено
}

model FunnelHistory {
  id        String       @id @default(cuid())
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromStage FunnelStage?
  toStage   FunnelStage
  note      String       @default("")
  createdAt DateTime     @default(now())
}

model Yacht {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String   @default("") // название лодки, отдельно от модели
  model     String   @default("")
  length    Decimal? @db.Decimal(5, 2)
  engine    String   @default("") // двигатель/привод
  marina    String   @default("")
  regNumber String   @default("")
  notes     String   @default("")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  quotes      Quote[]
  invoices    Invoice[]
  tasks       Task[]
  noteEntries Note[]    @relation("BoatNotes")

  @@index([clientId])
}

// Датированные заметки — привязка либо к клиенту, либо к лодке (ровно одна).
// Отдельно от Client.notes/Yacht.notes (тех единичных свободных полей) — здесь
// растущая лента дописываемых записей с датой и автором.
model Note {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  boatId    String?
  boat      Yacht?   @relation("BoatNotes", fields: [boatId], references: [id], onDelete: Cascade)
  authorId  String?
  author    CrmUser? @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([companyId, clientId])
  @@index([companyId, boatId])
}

// ─── ПРЕСМЕТЫ (QUOTES) ──────────────────────────────────────────

model Quote {
  id             String      @id @default(cuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id])
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id])
  boatId         String?
  boat           Yacht?      @relation(fields: [boatId], references: [id])
  number         String
  status         QuoteStatus @default(DRAFT)
  language       String      @default("ru")
  validUntil     DateTime?
  publicToken    String      @unique @default(cuid())
  acceptedAt     DateTime?
  ivaRate        Decimal     @default(21) @db.Decimal(5, 2)
  jobsTotal      Decimal     @default(0) @db.Decimal(12, 2) // Итого работа
  materialsTotal Decimal     @default(0) @db.Decimal(12, 2) // Итого материалы
  subtotal       Decimal     @default(0) @db.Decimal(12, 2) // База = jobsTotal + materialsTotal
  ivaAmount      Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @default(0) @db.Decimal(12, 2)
  notes          String      @default("")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  jobs     QuoteJob[]
  tasks    Task[]
  invoices Invoice[]
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

// Работа (родительская строка сметы) — нумеруется 1, 2, 3…
model QuoteJob {
  id         String   @id @default(cuid())
  quoteId    String
  quote      Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  title      String
  laborHours Decimal? @db.Decimal(6, 2)
  laborRate  Decimal? @db.Decimal(8, 2)
  quantity   Decimal? @db.Decimal(10, 3)
  unitPrice  Decimal? @db.Decimal(12, 2)
  laborCost  Decimal  @db.Decimal(12, 2)

  materials QuoteMaterial[]
}

// Материал (дочерняя строка внутри работы) — нумеруется 1.1, 1.2…
model QuoteMaterial {
  id              String         @id @default(cuid())
  jobId           String
  job             QuoteJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sortOrder       Int            @default(0)
  name            String
  quantity        Decimal        @db.Decimal(10, 3)
  unitPrice       Decimal        @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
}

// ─── ЗАДАЧИ / РАБОТЫ ────────────────────────────────────────────

model Task {
  id                  String     @id @default(cuid())
  companyId           String
  company             Company    @relation(fields: [companyId], references: [id])
  title               String
  description         String     @default("")
  clientId            String?
  client              Client?    @relation(fields: [clientId], references: [id])
  boatId              String?
  boat                Yacht?     @relation(fields: [boatId], references: [id])
  quoteId             String?
  quote               Quote?     @relation(fields: [quoteId], references: [id])
  assigneeId          String?
  assignee            CrmUser?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  marina              String     @default("")
  status              TaskStatus @default(NEW)
  scheduledAt         DateTime?
  startTime           DateTime?
  endTime             DateTime?
  isBacklog           Boolean    @default(false)
  checklist           Json       @default("[]")
  photosBefore        String[]
  photosAfter         String[]
  // Материалы, привязанные к задаче: [{ itemId, name, unit, qty }] — снапшот на момент привязки.
  // Списываются со склада (StockMovement WRITE_OFF) автоматически при переходе в DONE.
  plannedMaterials    Json       @default("[]")
  materialsWrittenOff Boolean    @default(false)
  completedAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  stockUsage StockMovement[]
  reminders  Reminder[]

  @@index([companyId, status])
  @@index([companyId, scheduledAt])
  @@index([companyId, marina])
}

enum TaskStatus {
  NEW
  SCHEDULED
  IN_PROGRESS
  DONE
  PROBLEM
}

// ─── СКЛАД ──────────────────────────────────────────────────────

model InventoryItem {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  category    String   @default("")
  unit        String   @default("шт")
  qtyInStock  Decimal  @default(0) @db.Decimal(10, 3)
  qtyOrdered  Decimal  @default(0) @db.Decimal(10, 3)
  qtyMinAlert Decimal  @default(0) @db.Decimal(10, 3)
  costPrice   Decimal  @default(0) @db.Decimal(12, 2)
  sellPrice   Decimal  @default(0) @db.Decimal(12, 2)
  supplier    String   @default("")
  notes       String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements        StockMovement[]
  quoteMaterials   QuoteMaterial[]
  invoiceMaterials InvoiceMaterial[]

  @@index([companyId])
}

model StockMovement {
  id        String            @id @default(cuid())
  companyId String
  itemId    String
  item      InventoryItem     @relation(fields: [itemId], references: [id])
  taskId    String?
  task      Task?             @relation(fields: [taskId], references: [id])
  invoiceId String?
  invoice   Invoice?          @relation(fields: [invoiceId], references: [id])
  type      StockMovementType
  qty       Decimal           @db.Decimal(10, 3)
  unitPrice Decimal           @default(0) @db.Decimal(12, 2)
  total     Decimal           @default(0) @db.Decimal(12, 2)
  note      String            @default("")
  createdAt DateTime          @default(now())

  @@index([companyId, type])
  @@index([itemId])
  @@index([invoiceId])
}

enum StockMovementType {
  RECEIVE // Приёмка
  WRITE_OFF // Списание в работу
  SELL // Продажа
  ADJUST // Корректировка
  ORDER // Заказ (в пути)
}

// ─── ФИНАНСЫ ────────────────────────────────────────────────────

// Растущий справочник категорий доходов/расходов/зарплат — создаётся на лету
// прямо из формы ввода. FinanceEntry ссылается по id, поэтому переименование
// категории не ломает историю (старые записи автоматически показывают новое
// имя через связь); category-строка на FinanceEntry — снимок на случай записей
// без categoryId (сделанных до появления этой модели или другим кодом).
model Category {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  kind      CategoryKind
  name      String
  sortOrder Int          @default(0)
  archived  Boolean      @default(false)

  entries FinanceEntry[]

  @@unique([companyId, kind, name])
  @@index([companyId, kind, archived])
}

enum CategoryKind {
  INCOME
  EXPENSE
  SALARY
}

// Операционные записи: входят в P&L и в кассу
model FinanceEntry {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  autoId         String           @unique // EXP-2025-001 | INC-... | SAL-...
  type           FinanceEntryType
  date           DateTime
  category       String
  categoryId     String?
  categoryRef    Category?        @relation(fields: [categoryId], references: [id])
  // Поле поддерживает арифметику: "168.23/2" — хранится и выражение, и результат
  amountExpr     String           @default("")
  // ВСЕГДА нетто (без IVA) — вот на чём держится «P&L только нетто». Для
  // расхода с IVA сюда пишется вычисленная база, а не введённая пользователем
  // сумма; см. hasVat/vatRate/vatAmount и VatEntry (IVA soportado, отдельно).
  amount         Decimal          @db.Decimal(12, 2)
  hasVat         Boolean          @default(false)
  vatRate        Decimal          @default(0) @db.Decimal(5, 2)
  vatAmount      Decimal          @default(0) @db.Decimal(12, 2)
  paymentMethod  String           @default("")
  description    String           @default("")
  clientId       String?
  client         Client?          @relation(fields: [clientId], references: [id])
  invoiceId      String?
  invoice        Invoice?         @relation(fields: [invoiceId], references: [id])
  receiptUrl     String?
  receiptDriveId String?
  sheetsSynced   Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  vatEntry VatEntry?

  // Сторно-запись ссылается на операцию, которую она отменяет (полностью или
  // частично) — проведённые операции никогда не удаляются и не редактируются
  // по сумме напрямую, только компенсируются обратной записью с отрицательной
  // amount того же type. История остаётся видна целиком через эту цепочку.
  reversalOfId String?
  reversalOf   FinanceEntry?  @relation("Reversal", fields: [reversalOfId], references: [id])
  reversals    FinanceEntry[] @relation("Reversal")

  @@index([companyId, type, date])
  @@index([categoryId])
  @@index([reversalOfId])
}

enum FinanceEntryType {
  INCOME // Доход
  EXPENSE // Расход
  SALARY // Зарплата
}

// Вложения — НЕ входят в P&L никогда
model CapitalEntry {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id])
  autoId       String           @unique // INV-2025-001
  type         CapitalEntryType
  date         DateTime
  source       String           @default("")
  amount       Decimal          @db.Decimal(12, 2)
  note         String           @default("")
  sheetsSynced Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([companyId, type, date])
}

// Три типа вложений — строго
enum CapitalEntryType {
  REINVESTMENT // Доинвестиции → попадают в кассу
  STARTUP_ASSET // Стартовые → актив (фургон, залог)
  STARTUP_SUNK // Стартовые невозвратные (риелтор, аренда при въезде)
}

// IVA-книга: repercutido (собран с клиентов по фактурам, обязательство к уплате)
// и soportado (уплачен поставщикам по расходам, к вычету). НИКОГДА не входит в
// P&L — используется только для расчёта «IVA к уплате» = repercutido − soportado.
// Каждая запись привязана к своему источнику (Invoice или FinanceEntry) для
// прозрачного drill-down.
model VatEntry {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  direction      VatDirection
  date           DateTime
  baseAmount     Decimal       @db.Decimal(12, 2) // база (нетто), для справки
  rate           Decimal       @db.Decimal(5, 2)
  amount         Decimal       @db.Decimal(12, 2) // сумма IVA
  invoiceId      String?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  financeEntryId String?       @unique
  financeEntry   FinanceEntry? @relation(fields: [financeEntryId], references: [id], onDelete: Cascade)
  note           String        @default("")
  createdAt      DateTime      @default(now())

  @@index([companyId, direction, date])
}

enum VatDirection {
  REPERCUTIDO // Собран с клиентов по фактурам — обязательство к уплате
  SOPORTADO // Уплачен поставщикам по расходам — к вычету
}

// ─── СЧЕТА (FACTURAS) ────────────────────────────────────────────

model Invoice {
  id                  String        @id @default(cuid())
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id])
  clientId            String
  client              Client        @relation(fields: [clientId], references: [id])
  boatId              String?
  boat                Yacht?        @relation(fields: [boatId], references: [id])
  quoteId             String?
  quote               Quote?        @relation(fields: [quoteId], references: [id])
  number              String // F2025-001 — для черновиков временный вид "ЧЕРНОВИК-xxxx" до выпуска
  year                Int? // null пока счёт черновик — не занимает сквозной номер
  sequenceNum         Int? // null пока счёт черновик
  status              InvoiceStatus @default(ISSUED)
  language            String        @default("ru")
  date                DateTime      @default(now())
  dueDate             DateTime?
  paymentMethod       String        @default("")
  paidAt              DateTime?
  ivaRate             Decimal       @default(21) @db.Decimal(5, 2)
  irpfRate            Decimal       @default(0) @db.Decimal(5, 2)
  jobsTotal           Decimal       @default(0) @db.Decimal(12, 2) // Итого работа
  materialsTotal      Decimal       @default(0) @db.Decimal(12, 2) // Итого материалы
  subtotal            Decimal       @db.Decimal(12, 2) // База = jobsTotal + materialsTotal
  ivaAmount           Decimal       @db.Decimal(12, 2)
  irpfAmount          Decimal       @default(0) @db.Decimal(12, 2)
  total               Decimal       @db.Decimal(12, 2)
  // Снапшот реквизитов клиента на момент выпуска
  clientName          String
  clientNif           String        @default("")
  clientAddress       String        @default("")
  notes               String        @default("")
  pdfUrl              String?
  // Списание материалов со склада произошло при выставлении (идемпотентность
  // каскада «фактура → склад»); при аннулировании материалы возвращаются и флаг сбрасывается.
  materialsWrittenOff Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  jobs           InvoiceJob[]
  finances       FinanceEntry[]
  stockMovements StockMovement[]
  vatEntries     VatEntry[]

  @@unique([companyId, year, sequenceNum])
  @@index([companyId, status])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

// Работа (родительская строка счёта) — нумеруется 1, 2, 3…
model InvoiceJob {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  title      String
  laborHours Decimal? @db.Decimal(6, 2)
  laborRate  Decimal? @db.Decimal(8, 2)
  quantity   Decimal? @db.Decimal(10, 3)
  unitPrice  Decimal? @db.Decimal(12, 2)
  laborCost  Decimal  @db.Decimal(12, 2)

  materials InvoiceMaterial[]
}

// Материал (дочерняя строка внутри работы) — нумеруется 1.1, 1.2…
model InvoiceMaterial {
  id              String         @id @default(cuid())
  jobId           String
  job             InvoiceJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sortOrder       Int            @default(0)
  name            String
  quantity        Decimal        @db.Decimal(10, 3)
  unitPrice       Decimal        @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
}

// ─── СПРАВОЧНИКИ ────────────────────────────────────────────────

model ReferenceItem {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id])
  type      ReferenceType
  value     String
  label     String
  sortOrder Int           @default(0)
  active    Boolean       @default(true)

  @@unique([companyId, type, value])
  @@index([companyId, type])
}

enum ReferenceType {
  EXPENSE_CATEGORY
  INCOME_CATEGORY
  PAYMENT_METHOD
  CLIENT_SOURCE
  MARINA
  TASK_STATUS
  INVENTORY_CATEGORY
}

// ─── НАПОМИНАНИЯ ────────────────────────────────────────────────

model Reminder {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  type        ReminderType
  title       String
  scheduledAt DateTime
  clientId    String?
  taskId      String?
  task        Task?        @relation(fields: [taskId], references: [id])
  invoiceId   String?
  sent        Boolean      @default(false)
  sentAt      DateTime?
  createdAt   DateTime     @default(now())

  @@index([companyId, scheduledAt, sent])
}

enum ReminderType {
  INVOICE_OVERDUE
  STALE_LEAD
  SEASONAL_SERVICE
  LOW_STOCK
  CUSTOM
}

// ─── KPI-ЦЕЛИ ────────────────────────────────────────────────────

model KpiGoal {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  month     Int
  year      Int
  revenue   Decimal  @default(0) @db.Decimal(12, 2)
  margin    Decimal  @default(0) @db.Decimal(12, 2)
  notes     String   @default("")
  createdAt DateTime @default(now())

  @@unique([companyId, year, month])
}
